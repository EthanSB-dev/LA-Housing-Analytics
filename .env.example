# Copy this file to ".env" (same folder) and fill in your real values.
# ".env" is listed in .gitignore -- it will NEVER be committed or pushed to GitHub.
# ".env.example" (this file) IS committed, so anyone cloning the repo knows
# which variables they need to supply themselves.

# Free signup: https://data.lacity.org (create account) -> profile -> Edit App Tokens
LA_OPEN_DATA_APP_TOKEN=your_socrata_app_token_here

# Free signup: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key_here
