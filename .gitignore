# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Data: raw/processed data is regenerable from the ingestion scripts and can
# get large, so we keep it out of git and .gitkeep the empty folders instead.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# DuckDB database file (regenerable from raw data + SQL, not source-of-truth)
*.duckdb

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# VS Code
.vscode/

#Tableau
.~*.twbr